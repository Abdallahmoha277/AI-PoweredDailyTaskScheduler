# =====================================================================
# TaskFlow AI - Environment Variables
# Copy this file to .env and fill in your real credentials.
# =====================================================================
#
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api-keys
#
# ⚠️  Use the LEGACY anon key (starts with "eyJ...") — the newer
#     "sb_publishable_..." keys are not yet supported by this app.
# =====================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
